MONGO_URI=mongodb://localhost:27017/phatak_radar
PORT=5000
CORS_ORIGIN=http://localhost:3000
# RailRadar (https://railradar.in) — backend only, never exposed to the frontend.
# Leave empty to disable live data (health reports railradar: "disabled").
RAILRADAR_API_KEY=
# Hard cap on RailRadar calls per IST day (free plan = 1,000/month).
RAILRADAR_DAILY_CAP=30
# Enables PIN-protected gatekeeper overrides (POST /api/phataks/:id/status). Leave empty to disable.
GATEKEEPER_PIN=
# Salt for hashing reporter IPs (raw IPs are never stored).
REPORT_SALT=
